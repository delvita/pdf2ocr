# Beispiel-Umgebungsvariablen
# Setze einen starken API Key, um den OCR-Webhook zu schützen.
API_KEY=changeme_replace_with_strong_value
FLASK_ENV=production
# OCR kann Minuten dauern; Gunicorn-Default wäre 30s (WORKER TIMEOUT)
GUNICORN_TIMEOUT=900
GUNICORN_GRACEFUL_TIMEOUT=900
# OCR: lange Seitenkante begrenzen (schneller), optional Tesseract-Timeout in Sek. (pytesseract mit timeout-Parameter)
OCR_MAX_DIMENSION=2000
# TESSERACT_TIMEOUT=180
