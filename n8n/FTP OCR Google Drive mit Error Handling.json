      "parameters": {
        "functionCode": "// Fehlerinformationen sammeln\nconst errorNode = $json.node?.name || 'Unbekannt';\nconst errorMessage = $json.error?.message || 'Keine Fehlermeldung verfügbar';\nconst fileName = $input.first()?.json?.name || 'Unbekannte Datei'; // Sichere Referenz\nconst timestamp = new Date().toLocaleString('de-DE');\nconst stackTrace = $json.error?.stack?.substring(0, 500) || 'Kein Stack Trace';\n\nreturn {\n  json: {\n    errorNode,\n    errorMessage,\n    fileName,\n    timestamp,\n    stackTrace,\n    workflowId: $workflow.id,\n    executionId: $execution.id\n  }\n};"
      },
